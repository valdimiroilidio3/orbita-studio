# ===========================================================================
# ORBITA — variáveis de ambiente (1.18.0)
# Copia para .env (nunca comites o .env). Na Vercel: Settings → Environment Vars.
# Regra: NUNCA metas estas chaves em variáveis NEXT_PUBLIC_/VITE_ — isso publica-as.
# ===========================================================================

# ---- base de dados (necessária; a integração Supabase da Vercel cria-as) ----
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ---- IA: basta UMA destas para o motor arrancar ----
OPENROUTER_API_KEY=
GROQ_API_KEY=
GOOGLE_AI_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
HF_TOKEN=
NVIDIA_API_KEY=
AI_GATEWAY_API_KEY=
# pagas, opcionais
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# ---- servidor local (npm start) ----
ORBITA_API_TOKEN=
PORT=4550
