# ===========================================================================
# ÓRBITA — variáveis de ambiente (revisto na 1.41.0)
#
# Copia para `.env` na tua máquina (`cp .env.example .env`, nunca comites o
# .env). Em produção, cola-as na Vercel: Settings → Environment Variables.
#
# Regra: NUNCA metas estas chaves em variáveis NEXT_PUBLIC_/VITE_ — isso publica-as.
# A única excepção é NEXT_PUBLIC_SUPABASE_URL, que é só o endereço (e o código
# aceita SUPABASE_URL, que é o nome recomendado).
#
# Antes de publicar:  npm run prontidao
# É a mesma lista que `/api/health` resume e que `/sistema/prontidao` devolve.
# ===========================================================================

# ---- 1 · BASE DE DADOS (crítica) ------------------------------------------
# Supabase → Project Settings → API. A chave secreta fica SÓ no servidor.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# A chave antiga (service_role) continua a ser aceite, para não partir o que já existe:
# SUPABASE_SERVICE_ROLE_KEY=

# ---- 2 · ESQUEMA (crítica) ------------------------------------------------
# A URL directa do Postgres (Database → Connection string → URI). Só serve para
# `/api/setup` criar as tabelas; o resto da aplicação usa REST.
DATABASE_URL=
# Inventa uma frase longa. Autoriza `GET /api/setup?token=…` (e apaga-se depois).
SETUP_TOKEN=

# ---- 3 · ACESSO (crítica) -------------------------------------------------
# 32 caracteres ou mais. Sem isto o `/api/*` fica aberto a quem tiver o endereço.
ORBITA_API_TOKEN=
# Protege a página e a mesa quando ainda não há contas (16 caracteres ou mais).
ORBITA_ADMIN_TOKEN=

# ---- 4 · PESQUISA (essencial para a prospeção) ----------------------------
# app.tavily.com — pesquisa web e leitura de páginas.
TAVILY_API_KEY=
# myprojects.geoapify.com — empresas reais por actividade e cidade.
GEOAPIFY_API_KEY=

# ---- 5 · CORREIO (essencial para as mensagens saírem) ---------------------
# resend.com — envia e recebe. O domínio do remetente tem de estar verificado.
RESEND_API_KEY=
# O `from` dos teus emails. Os dois nomes funcionam; este é o recomendado.
ORBITA_FROM_EMAIL=
# prova que uma resposta veio mesmo do Resend (Dashboard → Webhooks).
RESEND_WEBHOOK_SECRET=

# ---- 6 · WHATSAPP (opcional: sem isto abre na app e confirma-se à mão) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=
# o `hub.verify_token` que colas no painel da Meta
WHATSAPP_VERIFY_TOKEN=

# ---- 7 · IA ---------------------------------------------------------------
# Basta UMA. Sem nenhuma, o escritório arranca na cadeia gratuita
# (LLM7, OVH, Pollinations) — escreve, mas não mexe em ferramentas.
OPENROUTER_API_KEY=
GROQ_API_KEY=
GOOGLE_AI_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
AI_GATEWAY_API_KEY=
# pagas, opcionais
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# ---- 8 · DIGITALIZAR PAPEL (opcional) -------------------------------------
# Um endpoint de OCR que devolve o texto da imagem. Sem isto, a digitalização
# diz que falta o serviço em vez de inventar campos.
ORBITA_OCR_URL=

# ---- 9 · SERVIDOR LOCAL (npm start) --------------------------------------
PORT=4550
# Onde vive a base local quando não há Supabase (por omissão: ./data)
# ORBITA_DATA_DIR=
