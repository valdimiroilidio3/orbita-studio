# ---------------------------------------------------------------------------
# As APIs reais (28 out 2026): preenche o que tiveres e grava — o servidor vigia este ficheiro,
# carrega a chave a quente e sonda o serviço SEM reiniciar. O retrato completo está em
# http://localhost:4520/api/platform e no terminal (tecla F → :api). Guia: docs/PLATAFORMA.md
# Já reconhecidas: OPENAI_API_KEY, ANTHROPIC_API_KEY, GEMINI_API_KEY, OPENROUTER_API_KEY,
# GROQ_API_KEY, MISTRAL_API_KEY, HF_TOKEN, REPLICATE_API_TOKEN, ELEVENLABS_API_KEY,
# GOOGLE_MAPS_API_KEY, GOOGLE_SEARCH_KEY+GOOGLE_SEARCH_CX, SUPABASE_URL+SUPABASE_SERVICE_ROLE_KEY,
# AIRTABLE_TOKEN, NOTION_TOKEN, GITHUB_TOKEN, VERCEL_TOKEN, CLOUDFLARE_API_TOKEN,
# AWS_ACCESS_KEY_ID+AWS_SECRET_ACCESS_KEY, STRIPE_SECRET_KEY, SHOPIFY_STORE_DOMAIN+SHOPIFY_ADMIN_TOKEN,
# RESEND_API_KEY, SENDGRID_API_KEY, TWILIO_ACCOUNT_SID+TWILIO_AUTH_TOKEN, TELEGRAM_BOT_TOKEN,
# SLACK_BOT_TOKEN, DISCORD_BOT_TOKEN, META_ACCESS_TOKEN.
# Serviços fora desta lista: api-providers.example.json → data/api/providers.json
# ---------------------------------------------------------------------------

# Optional cloud CRM storage. Apply supabase/orbita_schema.sql first.

# A palavra-passe da instalação (16+ caracteres). Sem ela, o Órbita está em MODO LOCAL: qualquer
# pessoa com acesso à porta manda. Com ela, /api/ops exige o cabeçalho x-orbita-admin (o escritório
# e a mesa pedem o token uma vez e guardam-no no browser).
ORBITA_ADMIN_TOKEN=

# Sessões e contas. O Órbita passa a exigir entrada quando existe pelo menos uma conta; a
# primeira cria-se em /app (só é possível uma vez) e é a do dono.
ORBITA_SESSION_HOURS=12
# '1' força o cookie de sessão a Secure (só https); '0' desliga. Sem valor, decide pelo
# x-forwarded-proto do proxy.
ORBITA_SECURE_COOKIE=
# 'sessao' desliga a credencial de máquina (ORBITA_ADMIN_TOKEN) e aceita só contas — é o modo
# certo para uma instalação exposta na internet.
ORBITA_AUTH=

# Publicação (opcional). Sem estes valores, «entregar» diz exactamente o que falta em vez de fingir.
# Vercel → Project Settings → Git → Deploy Hooks.
VERCEL_DEPLOY_HOOK=
# Repositório alvo para o fluxo de GitHub (owner/repo). O envio ainda não está implementado.
GITHUB_REPO=

# Testes de navegador no QA (Playwright). Desligados por omissão; sem Chromium instalado ficam
# registados como NÃO executados — nunca como aprovados.
E2E=0

# Google AI Studio key (aistudio.google.com/apikey). One key, two jobs:
#   1. the office's own motor — the native generateContent API (no CLI installed, no login);
#      set AO_AI=gemini-api to force it, or leave the default and it is chosen when a key exists;
#   2. optional copy drafting in the integrations layer (geminiAssist).
# The model below is what the integrations layer uses; the motor uses gemini-flash-latest unless
# you set AO_AI_MODEL (or ai.model in office.config.local.json).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional cloud CRM storage. Apply supabase/orbita_schema.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional individual transactional/requested-follow-up emails via Resend.
RESEND_API_KEY=
ORBITA_EMAIL_FROM=

# Optional GitHub token. Public metadata reads work without it; file commits require Contents: write. Use a fine-grained token scoped to the target repo.
GITHUB_TOKEN=

# Optional Instagram image publishing. Requires Meta app + approved permissions + public HTTPS images.
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_GRAPH_API_VERSION=

# Optional alternate OpenStreetMap service endpoints (switch if provider requests it).
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Optional Vercel redeploy hook (secret URL; configure only after creating it in Vercel project settings).
VERCEL_DEPLOY_HOOK_URL=
