# ORBITA local/server API authentication. Generate 32+ random bytes; do not commit .env.
# Example generation: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ORBITA_API_TOKEN=

# A palavra-passe da instalação (16+ caracteres). Sem ela, o Órbita está em MODO LOCAL: qualquer
# pessoa com acesso à porta manda. Com ela, /api/ops exige o cabeçalho x-orbita-admin (o escritório
# e a mesa pedem o token uma vez e guardam-no no browser).
ORBITA_ADMIN_TOKEN=

# Publicação (opcional). Sem estes valores, «entregar» diz exactamente o que falta em vez de fingir.
# Vercel → Project Settings → Git → Deploy Hooks.
VERCEL_DEPLOY_HOOK=
# Repositório alvo para o fluxo de GitHub (owner/repo). O envio ainda não está implementado.
GITHUB_REPO=

# Google AI Studio key (aistudio.google.com/apikey). One key, two jobs:
#   1. the office's own motor — the native generateContent API (no CLI installed, no login);
#      set AO_AI=gemini-api to force it, or leave the default and it is chosen when a key exists;
#   2. optional copy drafting in the integrations layer (geminiAssist).
# The model below is what the integrations layer uses; the motor uses gemini-flash-latest unless
# you set AO_AI_MODEL (or ai.model in office.config.local.json).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional cloud CRM storage. Apply supabase/orbita_schema.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional individual transactional/requested-follow-up emails via Resend.
RESEND_API_KEY=
ORBITA_EMAIL_FROM=

# Optional GitHub token. Public metadata reads work without it; file commits require Contents: write. Use a fine-grained token scoped to the target repo.
GITHUB_TOKEN=

# Optional Instagram image publishing. Requires Meta app + approved permissions + public HTTPS images.
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_GRAPH_API_VERSION=

# Optional alternate OpenStreetMap service endpoints (switch if provider requests it).
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Optional Vercel redeploy hook (secret URL; configure only after creating it in Vercel project settings).
VERCEL_DEPLOY_HOOK_URL=
