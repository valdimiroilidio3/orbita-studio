{
  "name": "orbita",
  "version": "1.27.0",
  "description": "Órbita Agentes — um escritório isométrico 3D onde 35 agentes de IA trabalham em seis salas em volta de um Cérebro. Criado por Chelton Mahoze.",
  "author": "Chelton Mahoze",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node serve.mjs",
    "build": "node build.mjs",
    "test:scene": "node scene.smoke.mjs",
    "test:office": "node --test office.test.mjs",
    "test:circulation": "node --test circulation.test.mjs",
    "test:a11y": "node --test a11y.test.mjs",
    "check": "node check.mjs",
    "check:live": "CHECK_LIVE=1 node check.mjs",
    "graph": "node graph-build.mjs",
    "test:integrations": "node --test integrations.test.mjs google.test.mjs",
    "test:ops": "node --test ops.test.mjs",
    "test:forge": "node --test forge.test.mjs",
    "test:platform": "node --test platform.test.mjs",
    "test:term": "node --test terminal.test.mjs",
    "forge": "node tools/forge.mjs",
    "brand": "node tools/brand.mjs",
    "release": "node tools/brand.mjs && node build.mjs",
    "test:settings": "node --test settings.test.mjs",
    "test:local": "node --test localapi.test.mjs",
    "test:mesa": "node mesa.smoke.mjs",
    "test:api": "node --test api.test.mjs",
    "test:ia": "node --test ia.test.mjs estudio.test.mjs",
    "test:pesquisa": "node --test pesquisa.test.mjs",
    "test:backup": "node --test backup.test.mjs",
    "test:conectar": "node --test conectar.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@vercel/connect": "^2.5.6",
    "d3-force": "^3.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.62.0",
    "three": "^0.185.1"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.80.0"
  },
  "homepage": "https://orbita-agentes.vercel.app"
}
