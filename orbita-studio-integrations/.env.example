# Órbita Studio — integrações
#
# Copia este ficheiro para .env e preenche SÓ o que queres ligar:
#     cp .env.example .env
#
# O .env nunca entra no git. As chaves vivem no ambiente ou aqui — em mais lado nenhum.
# Sem ORBITA_API_TOKEN o servidor não arranca (falha fechado, de propósito).

# ── Obrigatório ───────────────────────────────────────────────────────────────
# 32+ caracteres. Gera um com:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ORBITA_API_TOKEN=

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=4530
HOST=0.0.0.0
# Pedidos por minuto, por token
RATE_LIMIT=120
# Onde ficam leads, rascunhos e supressões (por omissão: ./data deste pacote)
# ORBITA_DATA_DIR=./data

# ── OpenStreetMap (leads) — não precisa de chave ──────────────────────────────
# Usa os serviços públicos por omissão. Se tiveres instâncias próprias, aponta aqui
# (recomendado para volume: as políticas do Nominatim limitam a 1 pedido/segundo).
# OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
# OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter

# ── Supabase (CRM) — opcional; sem isto os leads ficam em JSON local ─────────
# Requer a tabela orbita_leads (ver docs/INTEGRATIONS.md).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend (email transacional, um-a-um, só com aprovação) ───────────────────
RESEND_API_KEY=
ORBITA_EMAIL_FROM=

# ── Gemini (assistência de escrita) ──────────────────────────────────────────
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# ── GitHub (leitura pública; escrita exige token fino + aprovação) ───────────
GITHUB_TOKEN=

# ── Instagram Graph API (publicação aprovada) ────────────────────────────────
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_GRAPH_API_VERSION=20

# ── Vercel Deploy Hook (deploy aprovado; a URL é secreta) ────────────────────
VERCEL_DEPLOY_HOOK_URL=
